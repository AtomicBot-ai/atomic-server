@@ -48,11 +48,10 @@ const includesAny = (lower, needles) => needles.some((n) => lower.includes(n));
 /**
  * TurboQuant (`llamacpp`) can know an architecture and still expect a tensor layout that differs
  * from a valid upstream GGUF: re-downloading cannot fix that, and the same file loads in stock
- * llama.cpp, so there the mismatch is an unsupported architecture. Upstream it still means a
- * damaged file.
+ * llama.cpp, so there the mismatch is an unsupported architecture. Ollama conversions can differ from upstream too; tensor counts alone do not prove corruption.
  */
 const TENSOR_COUNT_MISMATCH = 'wrong number of tensors';
-const tensorLayoutIsArchitecture = (provider) => provider === 'llamacpp';
+const tensorLayoutIsArchitecture = (_provider) => true;
 export const ARGUMENT_REJECTED_MESSAGE = 'This llama.cpp backend does not accept one of the arguments it was started with. If you added custom arguments to this model, remove them; otherwise switch to another backend version or update Atomic Chat.';
 const CASCADE = [
     {
