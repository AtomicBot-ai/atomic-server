{
  "name": "@atomicbot-ai/atc",
  "version": "0.1.0",
  "description": "atc — the Atomic Chat server CLI: install an inference engine, pull a model, serve it over an OpenAI-compatible API, and manage it from a local web admin.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtomicBot-ai/eye-cli.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "atc": "./dist/bin.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/embed-admin-assets.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:ui": "npm run build --workspace packages/admin-ui",
    "embed:ui": "node scripts/embed-admin-assets.mjs",
    "build:bin": "npm run embed:ui && node scripts/build-binaries.mjs --host",
    "build:bin:all": "npm run embed:ui && node scripts/build-binaries.mjs --all",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/check-runtime-agnostic.mjs && node scripts/check-core-boundary.mjs && node scripts/gen-module-map.mjs --check && npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project contract",
    "test:watch": "vitest --project unit --project contract",
    "test:e2e": "vitest run --project e2e",
    "test:runtime-compat": "vitest run --project runtime-compat",
    "test:installers": "vitest run --project installers",
    "test:ui": "npm run test --workspace packages/admin-ui",
    "test:coverage": "vitest run --project unit --project contract --coverage",
    "docs:commands": "node scripts/gen-command-docs.mjs",
    "docs:modules": "node scripts/gen-module-map.mjs",
    "notices": "node scripts/gen-third-party-notices.mjs",
    "release": "node scripts/release.mjs",
    "verify:fast": "npm run lint && npm run typecheck && vitest run --project unit --project contract --changed",
    "verify": "npm run lint && npm run typecheck && npm run format:check && node scripts/gen-third-party-notices.mjs --check && npm test && npm run test:ui && npm run build && npm run build:ui && npm run build:bin && npm run test:e2e && npm run test:runtime-compat && npm run test:installers"
  },
  "dependencies": {
    "@atomic-chat/core": "0.19.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "ink": "^7.1.1",
    "pdfjs-dist": "4.8.69",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "react-devtools-core": "^6.1.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
